# Copy this file to .env and replace all example secrets before starting Docker Compose.
MYSQL_DATABASE=wanderlust_db
MYSQL_USER=wanderlust
MYSQL_PASSWORD=replace-with-a-strong-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_GENERATED_BASE64_SECRET
JWT_EXPIRATION_MS=3600000
APP_PORT=8080
MYSQL_PORT=3307

# For running the app directly outside Docker, the defaults are in application.properties.
# Set DB_URL, DB_USERNAME, DB_PASSWORD, and JWT_SECRET in your shell/IDE run configuration.
